{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "name": "Sammav Blue", "color": "#0B3D91" },
				{ "slug": "primary-dark", "name": "Navy", "color": "#071F4A" },
				{ "slug": "secondary", "name": "Teal", "color": "#0E7490" },
				{ "slug": "accent", "name": "Cyan", "color": "#22D3EE" },
				{ "slug": "base", "name": "White", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Mist", "color": "#F3F6FB" },
				{ "slug": "border", "name": "Border", "color": "#DCE3EE" },
				{ "slug": "muted", "name": "Slate", "color": "#475569" },
				{ "slug": "contrast", "name": "Ink", "color": "#0F172A" }
			],
			"gradients": [
				{ "slug": "hero", "name": "Hero", "gradient": "linear-gradient(135deg, #071F4A 0%, #0B3D91 55%, #0E7490 100%)" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 6vw, 5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 9vw, 7rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "System sans",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xx-large", "name": "XXL", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } },
				{ "slug": "huge", "name": "Huge", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			},
			"blockGap": "1.25rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--secondary)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "700", "lineHeight": "1.2", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "1.1" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "8px" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" } },
				"typography": { "fontWeight": "600", "fontSize": "1rem" },
				":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--accent)", "offset": "3px", "style": "solid", "width": "2px" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontWeight": "500", "fontSize": "1rem" }
			},
			"core/site-title": {
				"typography": { "fontWeight": "800", "fontSize": "1.25rem", "letterSpacing": "-0.02em" },
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--primary)" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-landing", "title": "Landing page (no title)", "postTypes": [ "page" ] }
	]
}
